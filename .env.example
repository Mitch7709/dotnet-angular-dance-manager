# Database Configuration
Database__ConnectionString=Server=your-server;Database=TheGroveDB;User Id=sa;Password=your-password;TrustServerCertificate=True;

# JWT Configuration
Jwt__Key=your-jwt-key-here

# Cloudinary Configuration
Cloudinary__CloudName=your-cloudinary-cloud-name
Cloudinary__ApiKey=your-cloudinary-api-key
Cloudinary__ApiSecret=your-cloudinary-api-secret

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5190